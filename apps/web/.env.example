# Agentic Hub web app. Copy to .env.local for local development, and set the
# same variables in Vercel → Project → Settings → Environment Variables.

# Postgres connection string. On Vercel, add Neon from the Marketplace and it
# sets DATABASE_URL for you. Use the pooled connection string.
DATABASE_URL=postgres://user:password@host:5432/agentic_hub

# 32 random bytes, base64. Encrypts API keys, chat content and synced device
# data at rest. Generate with: openssl rand -base64 32
# Keep it secret and backed up: data encrypted with it can't be read without it.
AGENTIC_HUB_ENCRYPTION_KEY=

# Optional. Restrict sign-ups to these emails or @domains, comma-separated.
# Leave empty to allow anyone to sign up.
AGENTIC_HUB_ALLOWED_EMAILS=
