# Local runtime (apps/runtime). All optional. The desktop app sets these itself.

# Port on 127.0.0.1. 0 picks a free port. Default 43117.
AGENTIC_HUB_PORT=43117
# Where the encrypted SQLite database, its key and the token file live. Default ~/.agentic-hub
AGENTIC_HUB_DATA_DIR=
# Model API keys. Keys saved in Settings → Providers are stored encrypted and take precedence.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Muse Code reads META_API_KEY itself; set it here only if you don't sign in with `muse`.
META_API_KEY=
# Override CLI locations if they aren't on PATH.
AGENTIC_HUB_CLAUDE_BIN=
AGENTIC_HUB_MUSE_BIN=
